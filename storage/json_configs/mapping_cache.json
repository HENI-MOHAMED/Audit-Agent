{
  "companies": {
    "source_table": "res_company",
    "where_clause": null,
    "field_mapping": {
      "name": "name",
      "tax_id": "(SELECT vat FROM res_partner WHERE res_partner.id = res_company.partner_id)",
      "address": "(SELECT CONCAT(street, ', ', COALESCE(street2, ''), ', ', city, ', ', zip) FROM res_partner WHERE res_partner.id = res_company.partner_id)",
      "email": "email",
      "phone": "phone"
    }
  },
  "contacts": {
    "source_table": "res_partner",
    "where_clause": "active = true",
    "field_mapping": {
      "company_id": "company_id",
      "name": "name",
      "type": "type",
      "tax_number": "vat",
      "email": "email",
      "phone": "phone",
      "address": "CONCAT(COALESCE(street, ''), ', ', COALESCE(street2, ''), ', ', COALESCE(city, ''), ', ', COALESCE(zip, ''))",
      "source_system": "'odoo'",
      "source_id": "id"
    }
  },
  "products": {
    "source_table": "product_template",
    "where_clause": "active = true",
    "field_mapping": {
      "company_id": "company_id",
      "name": "name",
      "description": "description",
      "price": "list_price",
      "cost": "(SELECT standard_price FROM product_product WHERE product_product.product_tmpl_id = product_template.id LIMIT 1)",
      "type": "type",
      "source_system": "'odoo'",
      "source_id": "id"
    }
  },
  "taxes": {
    "source_table": "account_tax",
    "where_clause": "active = true",
    "field_mapping": {
      "company_id": "company_id",
      "name": "name",
      "rate": "amount",
      "type": "type_tax_use",
      "description": "description"
    }
  },
  "accounts": {
    "source_table": "account_account",
    "where_clause": "active = true",
    "field_mapping": {
      "company_id": "(SELECT res_company_id FROM account_account_res_company_rel WHERE account_account_res_company_rel.account_account_id = account_account.id LIMIT 1)",
      "code": "code_store",
      "name": "name",
      "type": "account_type",
      "source_system": "'odoo'",
      "source_id": "id"
    }
  },
  "journal_entries": {
    "source_table": "account_move",
    "where_clause": null,
    "field_mapping": {
      "company_id": "company_id",
      "entry_date": "date",
      "reference": "ref",
      "description": "narration",
      "source_system": "'odoo'",
      "source_id": "id",
      "movement_type": "move_type"
    }
  },
  "journal_lines": {
    "source_table": "account_move_line",
    "where_clause": null,
    "field_mapping": {
      "journal_entry_id": "move_id",
      "account_id": "account_id",
      "debit": "debit",
      "credit": "credit",
      "description": "name"
    }
  },
  "invoices": {
    "source_table": "account_move",
    "where_clause": "move_type IN ('in_invoice', 'out_invoice', 'in_refund', 'out_refund')",
    "field_mapping": {
      "supplier_id": "partner_id",
      "supplier_name": "(SELECT name FROM res_partner WHERE res_partner.id = account_move.partner_id)",
      "invoice_number": "name",
      "type": "move_type",
      "currency": "(SELECT name FROM res_currency WHERE res_currency.id = account_move.currency_id)",
      "exchange_rate": "invoice_currency_rate",
      "invoice_date": "invoice_date",
      "due_date": "invoice_date_due",
      "total_untaxed": "amount_untaxed",
      "total_tax": "amount_tax",
      "total_amount": "amount_total",
      "status": "state",
      "source_system": "'odoo'",
      "source_id": "id"
    }
  },
  "invoice_lines": {
    "source_table": "account_move_line",
    "where_clause": "move_id IN (SELECT id FROM account_move WHERE move_type IN ('in_invoice', 'out_invoice', 'in_refund', 'out_refund'))",
    "field_mapping": {
      "invoice_id": "move_id",
      "product_id": "product_id",
      "description": "name",
      "quantity": "quantity",
      "unit_price": "price_unit",
      "tax_id": "tax_line_id",
      "subtotal": "price_subtotal"
    }
  },
  "payments": {
    "source_table": "account_payment",
    "where_clause": null,
    "field_mapping": {
      "invoice_id": "(SELECT invoice_id FROM account_move__account_payment WHERE account_move__account_payment.payment_id = account_payment.id LIMIT 1)",
      "payment_date": "date",
      "amount": "amount",
      "payment_method": "(SELECT name FROM account_payment_method WHERE account_payment_method.id = account_payment.payment_method_id)",
      "reference": "payment_reference",
      "source_system": "'odoo'",
      "source_id": "id"
    }
  },
  "audit_results": {
    "source_table": "ir_logging",
    "where_clause": null,
    "field_mapping": {
      "entity_type": "'audit_result'",
      "entity_id": "id",
      "rule_name": "func",
      "risk_level": "level",
      "issue_detected": "message",
      "recommendation": "NULL",
      "ai_confidence": "NULL"
    }
  },
  "audit_logs": {
    "source_table": "ir_logging",
    "where_clause": null,
    "field_mapping": {
      "entity_type": "'audit_log'",
      "entity_id": "id",
      "action": "func",
      "details": "message",
      "average_score": "NULL",
      "ai_score": "NULL",
      "risk_level": "level"
    }
  },
  "purchase_orders": {
    "source_table": "purchase_order",
    "where_clause": null,
    "field_mapping": {
      "company_id": "company_id",
      "contact_id": "partner_id",
      "order_number": "name",
      "order_date": "date_order",
      "due_date": "date_planned",
      "total_amount": "amount_total",
      "status": "state",
      "source_system": "'odoo'",
      "source_id": "id"
    }
  },
  "purchase_order_lines": {
    "source_table": "purchase_order_line",
    "where_clause": null,
    "field_mapping": {
      "purchase_order_id": "order_id",
      "product_id": "product_id",
      "description": "name",
      "quantity": "product_qty",
      "unit_price": "price_unit",
      "tax_id": "(SELECT account_tax_id FROM account_tax_purchase_order_line_rel WHERE account_tax_purchase_order_line_rel.purchase_order_line_id = purchase_order_line.id LIMIT 1)",
      "subtotal": "price_subtotal"
    }
  },
  "inventory": {
    "source_table": "stock_quant",
    "where_clause": null,
    "field_mapping": {
      "company_id": "company_id",
      "product_id": "product_id",
      "quantity_on_hand": "quantity",
      "last_updated": "write_date",
      "source_system": "'odoo'",
      "source_id": "id"
    }
  },
  "inventory_logs": {
    "source_table": "stock_move",
    "where_clause": null,
    "field_mapping": {
      "supplier_id": "partner_id",
      "product_id": "product_id",
      "change_quantity": "product_qty",
      "change_type": "CASE WHEN is_in THEN 'in' WHEN is_out THEN 'out' ELSE 'other' END",
      "timestamp": "date",
      "source_system": "'odoo'",
      "source_id": "id"
    }
  }
}